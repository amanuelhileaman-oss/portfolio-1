# ==========================================
# Universal Root GitIgnore for Portfolio
# ==========================================

# 1. Environment & Secret Variables (CRITICAL SECURITY)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
backend/.env.*
frontend/.env.*

# Keep example template files tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# 3. Production Builds & Outputs
dist/
dist-ssr/
frontend/dist/
build/
out/
.next/
.nuxt/

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Certificates, Keys & Secrets
*.pem
*.key
*.cert
*.crt
*.pfx

# 6. Testing & Coverage
coverage/
.nyc_output/

# 7. OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
